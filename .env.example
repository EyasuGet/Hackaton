# Copy to .env for local development. Placeholder values only; never commit .env.
API_HOST=127.0.0.1
API_PORT=3000

# PostgreSQL started by `docker compose up`. Choose your own local-only password;
# Compose and the API both refuse to start while it is empty.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=track3
DATABASE_USER=track3
DATABASE_PASSWORD=

# Synthetic demo identities (T3-004-A). Leave false for any real deployment:
# when false, demo tokens are rejected and `pnpm demo:provision` refuses to run.
DEMO_MODE=false
# Exact page origins allowed to start a demo session (comma-separated), used only
# when DEMO_MODE=true. The Vite dev page is http://localhost:5173.
DEMO_ALLOWED_ORIGINS=http://localhost:5173

# Public HTTPS and reverse proxy deployment (T3-018-D).
# Used by compose.deployment.yaml and deploy/caddy/Caddyfile:
# DOMAIN: Fully-qualified domain name pointing to the public host (e.g. track3.example.org).
#         Defaults to localhost for local testing (uses Caddy internal self-signed TLS).
# CADDY_EMAIL: Email for Let's Encrypt / ACME registration. Set to 'internal' for local self-signed TLS.
DOMAIN=localhost
CADDY_EMAIL=internal

# Media relay / TURN configuration (T3-018-D).
# Used when direct WebRTC connections between learner and staff fail across symmetric NAT:
# TURN_ENABLED: false unless relay infrastructure is provisioned and authorized.
# TURN_URL: STUN/TURN URL advertised to clients (e.g. turns:relay.example.org:5349 or turn:relay.example.org:3478).
# TURN_REALM: Realm string matching the TURN server authentication realm.
# TURN_STATIC_AUTH_SECRET: Shared secret used to generate time-limited HMAC credentials (never commit!).
# TURN_EXTERNAL_IP: Publicly reachable IP address of the relay host for Coturn address mapping.
# Optional: when set, the Gemini transcription and answer providers call the live API.
# Leave empty to run with recorded probe responses (answers) or provider_unavailable (transcription).
GEMINI_API_KEY=
TURN_ENABLED=false
TURN_URL=
TURN_REALM=
TURN_STATIC_AUTH_SECRET=
TURN_EXTERNAL_IP=

# Telegram channel adapter and webhook security (T3-012-A).
# TELEGRAM_WEBHOOK_SECRET: Secret token sent in X-Telegram-Bot-Api-Secret-Token for webhook verification.
# TELEGRAM_BOT_TOKEN: Bot token for validating Telegram WebApp initData HMAC signatures (never commit!).
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=