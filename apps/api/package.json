{
  "name": "@track3/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "db:migrate": "node --env-file-if-exists=../../.env src/migrate.ts",
    "demo:provision": "node --env-file-if-exists=../../.env src/provision-demo.ts",
    "content:import": "node --env-file-if-exists=../../.env src/import-content.ts",
    "jobs:import": "node --env-file-if-exists=../../.env src/import-jobs.ts",
    "demo:handoff": "node --env-file-if-exists=../../.env src/demo-handoff.ts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.js",
    "test:integration": "vitest run integration.test",
    "eval:grounding": "node --env-file-if-exists=../../.env src/evaluations/grounding/run-eval.ts"
  },
  "dependencies": {
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1"
  },
  "license": "MIT"
}
