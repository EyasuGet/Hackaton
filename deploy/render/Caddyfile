# Caddy reverse proxy configuration for Render deployment
# Listens on Render's dynamically assigned $PORT (default 10000).
# Serves static web frontend and reverse-proxies /api/* to local Fastify API.

:{$PORT:10000} {
	root * /srv/web

	# Strict security headers matching WCAG / production requirements
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "display-capture=(self), microphone=(self)"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors *;"
	}

	# Immutable caching for hashed static bundles
	@hashedAssets path /assets/*
	header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

	# Revalidate HTML and service worker files
	@htmlFiles path *.html / /sw.js /manifest.json
	header @htmlFiles Cache-Control "no-cache, must-revalidate"

	# Reverse proxy API requests to local Fastify backend on port 3000
	handle /api/* {
		reverse_proxy http://127.0.0.1:3000 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	# Single-page application routing fallback
	handle {
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}
}
