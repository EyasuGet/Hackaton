{
  "name": "track3-assistant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --stream run dev",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "test:integration": "pnpm --filter @track3/api run test:integration",
    "db:migrate": "pnpm --filter @track3/api run db:migrate",
    "demo:provision": "pnpm --filter @track3/api run demo:provision",
    "content:import": "pnpm --filter @track3/api run content:import",
    "jobs:import": "pnpm --filter @track3/api run jobs:import",
    "demo:handoff": "pnpm --filter @track3/api run demo:handoff",
    "telegram:link": "pnpm --filter @track3/api run telegram:link",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "pnpm --filter @track3/web run test:e2e",
    "eval:grounding": "pnpm --filter @track3/api run eval:grounding",
    "eval:tutoring": "node --env-file-if-exists=.env scripts/run-bilingual-tutoring-eval.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}
